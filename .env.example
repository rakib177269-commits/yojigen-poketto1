# Copy to .env.local for local development. NEVER commit real values.
# On Netlify, set these under Project configuration -> Environment variables.
# Anything starting with NEXT_PUBLIC_ is sent to the browser: only public values there.

# Supabase project URL (Supabase dashboard -> Project Settings -> API). Public.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable / anon key. Public: it can only read the active catalogue (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service_role (secret) key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used by our API routes to call the order functions. Mark it "secret" in Netlify.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the site, no trailing slash (used for canonical links and the sitemap).
NEXT_PUBLIC_SITE_URL=https://yojigen-pokettobd.com

# ---- Pathao courier (Pathao merchant panel -> Developer API). All SERVER ONLY.
# Client ID and secret from "Merchant API Credentials".
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
# Older accounts also need the merchant panel login (email + password). Leave empty if not needed.
PATHAO_USERNAME=
PATHAO_PASSWORD=
# Any long random text you choose; type the same text into Pathao's webhook "secret" field.
PATHAO_WEBHOOK_SECRET=
# Only if Pathao's webhook page shows a different verification value than the default.
PATHAO_WEBHOOK_INTEGRATION_SECRET=
# Empty = live Pathao. For testing: https://courier-api-sandbox.pathao.com
PATHAO_BASE_URL=

# ---- Marketing (phase 6). Pixel / GA4 ids are entered in admin Settings (they are public).
# Meta Events Manager -> your Pixel -> Settings -> Conversions API -> Generate access token. SERVER ONLY.
META_CAPI_TOKEN=
# Only while testing: the code shown in Events Manager -> Test events. Remove afterwards.
META_TEST_EVENT_CODE=
# Optional: Graph API version (default v23.0).
META_GRAPH_VERSION=
# GA4 Admin -> Data streams -> your stream -> Measurement Protocol API secrets -> Create. SERVER ONLY.
GA4_API_SECRET=

# ---- Customer messages (phase 7). All SERVER ONLY.
# Email via Resend (resend.com). Verify yojigen-pokettobd.com in Resend first (DNS records in Netlify DNS).
RESEND_API_KEY=
# e.g. Yojigen Poketto <orders@yojigen-pokettobd.com>
EMAIL_FROM=
# Optional: where customer replies go, e.g. yujigenpoketto@gmail.com
EMAIL_REPLY_TO=
# SMS: "bulksmsbd" (bulksmsbd.net, needs SMS_SENDER_ID) or "alpha" (sms.net.bd, sender id optional).
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
