# Copy to .env.local for local development. NEVER commit real values.
# On Netlify, set these under Project configuration -> Environment variables.
# Anything starting with NEXT_PUBLIC_ is sent to the browser: only public values there.

# Supabase project URL (Supabase dashboard -> Project Settings -> API). Public.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable / anon key. Public: it can only read the active catalogue (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service_role (secret) key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used by our API routes to call the order functions. Mark it "secret" in Netlify.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the site, no trailing slash (used for canonical links and the sitemap).
NEXT_PUBLIC_SITE_URL=https://yojigen-pokettobd.com
